{
  "name": "picture-zip",
  "type": "module",
  "version": "1.0.0",
  "private": true,
  "description": "纯浏览器本地处理的批量图片压缩与格式转换工具",
  "scripts": {
    "dev": "astro dev",
    "prebuild": "node scripts/generate-og-image.mjs",
    "build": "astro build",
    "preview": "astro preview",
    "check": "astro check",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "test:all": "vitest run && playwright test",
    "audit:lighthouse": "lhci autorun",
    "audit:lighthouse:full": "lhci autorun --config=./lighthouserc.full.json"
  },
  "dependencies": {
    "@astrojs/preact": "^4.0.0",
    "@astrojs/sitemap": "^3.7.3",
    "@jsquash/avif": "^2.1.1",
    "@jsquash/jpeg": "^1.6.0",
    "@jsquash/oxipng": "^2.3.0",
    "@jsquash/png": "^3.1.1",
    "@jsquash/resize": "^2.1.1",
    "@jsquash/webp": "^1.5.0",
    "astro": "^5.0.0",
    "fflate": "^0.8.2",
    "gifenc": "^1.0.3",
    "gifuct-js": "^2.1.2",
    "libheif-js": "^1.19.8",
    "preact": "^10.24.0"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.0",
    "@lhci/cli": "^0.15.1",
    "@playwright/test": "^1.62.1",
    "happy-dom": "^20.12.0",
    "lighthouse": "^13.4.1",
    "sharp": "^0.35.4",
    "typescript": "^5.5.0",
    "vitest": "^2.1.0"
  }
}