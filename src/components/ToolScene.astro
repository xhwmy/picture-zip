---
import Layout from '../layouts/Layout.astro';
import { ImageTool } from './ImageTool';

interface Faq {
  q: string;
  a: string;
}

interface Props {
  lang?: 'en' | 'zh';
  title: string;
  description: string;
  heading: string;
  highlight?: string;
  subtitle: string;
  initialSettings?: Record<string, unknown>;
  targetModeDisabled?: boolean;
  faqs?: Faq[];
  webAppName?: string;
  webAppUrl?: string;
  useCases?: string[];
  steps?: string[];
  inputFormats?: string[];
  outputFormats?: string[];
  platforms?: string[];
  limitations?: string[];
}

const {
  lang = 'en',
  title,
  description,
  heading,
  highlight,
  subtitle,
  initialSettings,
  targetModeDisabled,
  faqs = [],
  webAppName,
  webAppUrl,
  useCases = [],
  steps = [],
  inputFormats = [],
  outputFormats = [],
  platforms = [],
  limitations = [],
} = Astro.props;

const isZh = lang === 'zh';

const webAppLd = {
  '@context': 'https://schema.org',
  '@type': 'WebApplication',
  name: webAppName ?? title,
  url: webAppUrl ?? 'https://picture-zip.com/',
  applicationCategory: 'MultimediaApplication',
  operatingSystem: 'Web',
  description,
  offers: { '@type': 'Offer', price: '0', priceCurrency: 'USD' },
};

const faqLd =
  faqs.length > 0
    ? {
        '@context': 'https://schema.org',
        '@type': 'FAQPage',
        mainEntity: faqs.map((f) => ({
          '@type': 'Question',
          name: f.q,
          acceptedAnswer: { '@type': 'Answer', text: f.a },
        })),
      }
    : null;
---

<Layout
  title={title}
  description={description}
  lang={lang}
  jsonLd={faqLd ? [webAppLd, faqLd] : [webAppLd]}
>
  <section class="hero">
    <div class="container">
      <h1 class="hero__title">
        {heading}
        {highlight && <span> {highlight}</span>}
      </h1>
      <p class="hero__subtitle">{subtitle}</p>
      <div class="hero__badges">
        <span class="badge badge--accent">{isZh ? '100% 本地处理' : '100% Local Processing'}</span>
        <span class="badge badge--green">{isZh ? '文件不离开你的设备' : 'Files never leave your device'}</span>
      </div>
    </div>
  </section>

  <section class="container tool-section">
    <ImageTool client:only="preact" initialSettings={initialSettings} targetModeDisabled={targetModeDisabled} />
  </section>

  {(useCases.length > 0 || steps.length > 0) && (
    <section class="container info-section">
      {steps.length > 0 && (
        <div class="card info-card">
          <h2>{isZh ? '使用步骤' : 'How to use'}</h2>
          <ol class="info-steps">
            {steps.map((step, i) => (
              <li class="info-step">
                <span class="info-step__num">{i + 1}</span>
                <span class="info-step__text">{step}</span>
              </li>
            ))}
          </ol>
        </div>
      )}

      {useCases.length > 0 && (
        <div class="card info-card">
          <h2>{isZh ? '适用场景' : 'Use cases'}</h2>
          <ul class="info-list">
            {useCases.map((uc) => (
              <li>{uc}</li>
            ))}
          </ul>
        </div>
      )}
    </section>
  )}

  {(inputFormats.length > 0 || outputFormats.length > 0 || platforms.length > 0 || limitations.length > 0) && (
    <section class="container info-section">
      {inputFormats.length > 0 && (
        <div class="card info-card">
          <h2>{isZh ? '支持的输入格式' : 'Supported input formats'}</h2>
          <div class="format-tags">
            {inputFormats.map((f) => (
              <span class="format-tag">{f}</span>
            ))}
          </div>
        </div>
      )}

      {outputFormats.length > 0 && (
        <div class="card info-card">
          <h2>{isZh ? '输出格式' : 'Output formats'}</h2>
          <div class="format-tags">
            {outputFormats.map((f) => (
              <span class="format-tag format-tag--accent">{f}</span>
            ))}
          </div>
        </div>
      )}

      {platforms.length > 0 && (
        <div class="card info-card">
          <h2>{isZh ? '适用平台' : 'Supported platforms'}</h2>
          <ul class="info-list">
            {platforms.map((p) => (
              <li>{p}</li>
            ))}
          </ul>
        </div>
      )}

      {limitations.length > 0 && (
        <div class="card info-card">
          <h2>{isZh ? '限制说明' : 'Limitations'}</h2>
          <ul class="info-list">
            {limitations.map((l) => (
              <li>{l}</li>
            ))}
          </ul>
        </div>
      )}
    </section>
  )}

  {faqs.length > 0 && (
    <section class="container faq">
      <h2>{isZh ? '常见问题' : 'Frequently asked questions'}</h2>
      {faqs.map((f) => (
        <div class="faq__item">
          <h3>{f.q}</h3>
          <p>{f.a}</p>
        </div>
      ))}
    </section>
  )}
</Layout>

<style>
  .hero {
    background: linear-gradient(135deg, #0f172a 0%, #1e3a8a 55%, #2563eb 100%);
    color: #fff;
    padding: 56px 0 64px;
    text-align: center;
  }
  .hero__title {
    font-size: 38px;
    line-height: 1.2;
    font-weight: 800;
  }
  .hero__title span {
    color: #bfdbfe;
  }
  .hero__subtitle {
    margin: 16px auto 0;
    max-width: 560px;
    color: #cbd5e1;
    font-size: 17px;
  }
  .hero__badges {
    margin-top: 22px;
    display: flex;
    justify-content: center;
    flex-wrap: wrap;
    gap: 10px;
  }
  .tool-section {
    margin-top: -28px;
    position: relative;
  }
  .info-section {
    margin-top: 40px;
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(300px, 1fr));
    gap: 20px;
  }
  .info-card {
    margin: 0;
  }
  .info-card h2 {
    font-size: 18px;
    margin-bottom: 14px;
  }
  .info-steps {
    list-style: none;
    counter-reset: none;
    margin: 0;
    padding: 0;
  }
  .info-step {
    display: flex;
    align-items: flex-start;
    gap: 12px;
    margin-bottom: 14px;
  }
  .info-step__num {
    flex-shrink: 0;
    width: 28px;
    height: 28px;
    border-radius: 50%;
    background: var(--accent-soft);
    color: var(--accent);
    font-size: 13px;
    font-weight: 700;
    display: flex;
    align-items: center;
    justify-content: center;
  }
  .info-step__text {
    color: var(--muted);
    font-size: 14px;
    padding-top: 4px;
  }
  .info-list {
    margin: 0;
    padding: 0 0 0 18px;
  }
  .info-list li {
    margin: 6px 0;
    color: var(--muted);
    font-size: 14px;
  }
  .format-tags {
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
  }
  .format-tag {
    padding: 5px 12px;
    border-radius: 8px;
    background: #f1f5f9;
    color: var(--ink);
    font-size: 13px;
    font-weight: 600;
  }
  .format-tag--accent {
    background: var(--accent-soft);
    color: var(--accent);
  }
  .faq {
    margin-top: 48px;
    max-width: 720px;
  }
  .faq h2 {
    font-size: 24px;
    margin-bottom: 16px;
  }
  .faq__item {
    margin-bottom: 20px;
  }
  .faq__item h3 {
    font-size: 16px;
    margin-bottom: 6px;
  }
  .faq__item p {
    color: var(--muted);
    font-size: 14px;
  }
  @media (max-width: 640px) {
    .hero__title {
      font-size: 26px;
    }
    .hero {
      padding: 40px 0 52px;
    }
    .info-section {
      grid-template-columns: 1fr;
    }
  }
</style>
