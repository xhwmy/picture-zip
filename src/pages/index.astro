---
import Layout from '../layouts/Layout.astro';
import { ImageTool } from '../components/ImageTool';

const webAppLd = {
  '@context': 'https://schema.org',
  '@type': 'WebApplication',
  name: 'picture-zip — Image Compressor & Converter',
  url: 'https://picture-zip.com/',
  applicationCategory: 'MultimediaApplication',
  operatingSystem: 'Web',
  description:
    'Batch compress and convert images to JPEG, WebP, AVIF or PNG entirely in your browser. No upload, no limits.',
  offers: {
    '@type': 'Offer',
    price: '0',
    priceCurrency: 'USD',
  },
};

const faqLd = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: [
    {
      '@type': 'Question',
      name: 'Are my images uploaded to a server?',
      acceptedAnswer: {
        '@type': 'Answer',
        text: 'No. All processing happens locally in your browser using WebAssembly. Your files never leave your device.',
      },
    },
    {
      '@type': 'Question',
      name: 'Is there a limit on the number of images?',
      acceptedAnswer: {
        '@type': 'Answer',
        text: 'No hard limit. You can batch-process hundreds of images, though very large batches may use more memory.',
      },
    },
  ],
};
---

<Layout
  title="Compress & Convert Images for Free — picture-zip"
  description="Batch compress, resize and convert images to JPEG, WebP, AVIF or PNG for free. 100% local processing — files never leave your device."
  jsonLd={[webAppLd, faqLd]}
>
  <script slot="head">
    import '../scripts/lang-redirect';
  </script>
  <section class="hero">
    <div class="container hero__inner">
      <div class="hero__text">
        <h1 class="hero__title">Compress &amp; convert images<br /><span>without uploading</span></h1>
        <p class="hero__subtitle">
          Batch compress, resize and convert images to JPEG, WebP, AVIF or PNG — all locally in your browser.
        </p>
        <div class="hero__badges">
          <span class="badge badge--accent">100% Local</span>
          <span class="badge badge--green">No upload</span>
          <span class="badge badge--amber">No limit</span>
        </div>
      </div>
      <div class="hero__demo">
        <div class="hero__demo-item">
          <img src="/demo-before.jpg" alt="Before compression" loading="eager" width="200" height="150" />
          <span class="hero__demo-label">141 KB</span>
        </div>
        <div class="hero__demo-arrow" aria-hidden="true">→</div>
        <div class="hero__demo-item">
          <img src="/demo-after.jpg" alt="After compression" loading="eager" width="200" height="150" />
          <span class="hero__demo-label hero__demo-label--accent">13 KB</span>
        </div>
        <div class="hero__demo-badge">91% smaller</div>
      </div>
    </div>
  </section>

  <section class="container tool-section">
    <ImageTool client:only="preact" />
  </section>

  <section class="container faq">
    <h2>Frequently asked questions</h2>
    <div class="faq__item">
      <h3>Are my images uploaded to a server?</h3>
      <p>No. All processing happens locally in your browser using WebAssembly. Your files never leave your device.</p>
    </div>
    <div class="faq__item">
      <h3>Does compression reduce image quality?</h3>
      <p>Lossy formats (JPEG, WebP, AVIF) trade some quality for smaller size. You control the quality slider, or use target-size mode to hit a specific size.</p>
    </div>
    <div class="faq__item">
      <h3>What formats are supported?</h3>
      <p>Input: JPEG, PNG, WebP, GIF, AVIF. Output: JPEG, PNG, WebP, AVIF.</p>
    </div>
  </section>

  <section class="container app-download">
    <h2>Get the Android App</h2>
    <p>Compress images right on your phone — pick from gallery, compress, and replace originals in one tap.</p>
    <a href="/picture-app-v3.01.apk" class="download-btn" download>Download APK · v3.01 · 6.1 MB</a>
    <p class="app-download__note">Android only · requires Android 7.0+</p>
  </section>
</Layout>

<style>
  .hero {
    background: var(--bg);
    padding: 48px 0 56px;
    border-bottom: 1px solid var(--line);
  }
  .hero__inner {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 40px;
  }
  .hero__text {
    flex: 1;
  }
  .hero__title {
    font-size: 40px;
    line-height: 1.2;
    font-weight: 800;
    color: var(--ink);
  }
  .hero__title span {
    color: var(--accent);
  }
  .hero__subtitle {
    margin: 16px 0 0;
    max-width: 560px;
    color: var(--muted);
    font-size: 17px;
  }
  .hero__badges {
    margin-top: 22px;
    display: flex;
    flex-wrap: wrap;
    gap: 10px;
  }
  .hero__demo {
    position: relative;
    display: flex;
    align-items: center;
    gap: 16px;
    padding: 20px;
    background: #f8fafc;
    border-radius: 12px;
    border: 1px solid var(--line);
  }
  .hero__demo-item {
    text-align: center;
  }
  .hero__demo-item img {
    border-radius: 8px;
    border: 1px solid var(--line);
  }
  .hero__demo-label {
    display: block;
    margin-top: 8px;
    font-size: 13px;
    color: var(--muted);
  }
  .hero__demo-label--accent {
    color: var(--accent);
    font-weight: 600;
  }
  .hero__demo-arrow {
    font-size: 24px;
    color: var(--muted);
  }
  .hero__demo-badge {
    position: absolute;
    top: -10px;
    right: -10px;
    background: var(--accent);
    color: #fff;
    font-size: 12px;
    font-weight: 600;
    padding: 4px 10px;
    border-radius: 999px;
  }
  .tool-section {
    margin-top: -28px;
    position: relative;
  }
  .faq {
    margin-top: 48px;
    max-width: 720px;
  }
  .faq h2 {
    font-size: 24px;
    margin-bottom: 16px;
  }
  .faq__item {
    margin-bottom: 20px;
  }
  .faq__item h3 {
    font-size: 16px;
    margin-bottom: 6px;
  }
  .faq__item p {
    color: var(--muted);
    font-size: 14px;
  }
  .app-download {
    margin-top: 48px;
    max-width: 720px;
    padding: 28px 32px;
    background: var(--card);
    border: 1px solid var(--line);
    border-radius: var(--radius-lg);
    text-align: center;
  }
  .app-download h2 {
    font-size: 22px;
    margin-bottom: 8px;
  }
  .app-download p {
    color: var(--muted);
    font-size: 15px;
    margin-bottom: 20px;
  }
  .download-btn {
    display: inline-block;
    padding: 12px 32px;
    background: var(--accent);
    color: #fff;
    font-size: 16px;
    font-weight: 600;
    border-radius: 10px;
    text-decoration: none;
    transition: opacity 0.15s ease;
  }
  .download-btn:hover {
    opacity: 0.88;
  }
  .app-download__note {
    margin-top: 12px;
    font-size: 13px;
    color: var(--muted);
  }
  @media (max-width: 768px) {
    .hero__inner {
      flex-direction: column;
    }
    .hero__demo {
      width: 100%;
      justify-content: center;
    }
    .hero__demo-item img {
      width: auto;
      max-width: min(42vw, 160px);
      height: auto;
    }
    .hero__title {
      font-size: 28px;
    }
    .hero {
      padding: 32px 0 40px;
    }
  }
  @media (max-width: 640px) {
    .hero__demo {
      flex-wrap: wrap;
      justify-content: center;
      gap: 12px;
      padding: 16px;
      overflow: hidden;
    }
    .hero__demo-item img {
      width: min(40vw, 140px);
      max-width: min(40vw, 140px);
      height: auto;
    }
    .hero__demo-arrow {
      width: 100%;
      text-align: center;
      font-size: 20px;
    }
    .hero__demo-badge {
      top: 4px;
      right: 4px;
      font-size: 11px;
      padding: 3px 8px;
    }
  }
</style>