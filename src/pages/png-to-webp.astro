---
import ToolScene from '../components/ToolScene.astro';
---

<ToolScene
  title="PNG to WebP Converter — Free, 100% Local, Transparent"
  description="Convert PNG to WebP online for free with alpha transparency preserved. Batch convert — no upload, files never leave your device."
  heading="PNG to WebP"
  highlight="converter"
  subtitle="Convert PNG to WebP with transparency preserved. Smaller files, faster websites — all locally in your browser."
  initialSettings={{ format: 'webp' }}
  webAppName="PNG to WebP Converter"
  webAppUrl="https://picture-zip.com/png-to-webp/"
  inputFormats={['PNG (8-bit)', 'PNG (24-bit)', 'PNG (32-bit with alpha)']}
  outputFormats={['WebP (lossy + alpha)', 'WebP (lossless)', 'PNG (optimized)', 'AVIF']}
  platforms={[
    'Desktop: Chrome, Firefox, Edge, Safari',
    'Mobile: iOS Safari 16.4+, Android Chrome 100+',
    'Works offline once the page is loaded',
  ]}
  steps={[
    'Drag and drop your PNG file(s) onto the upload area.',
    'Output format is pre-set to WebP. Adjust quality with the slider if needed.',
    'Transparency (alpha channel) is automatically preserved.',
    'Download individually or as a ZIP for batch conversions.',
  ]}
  useCases={[
    'Reduce PNG file size for web performance (Lighthouse / Core Web Vitals)',
    'Batch-convert logos and icons with transparent backgrounds',
    'Optimize product images for e-commerce platforms',
    'Shrink PNG screenshots for email or messaging',
  ]}
  limitations={[
    'WebP lossy mode may slightly reduce quality at low settings — use quality 80+ for near-lossless',
    'Animated PNG (APNG) is not currently supported as input',
    'Very large PNGs (50MP+) may require significant memory',
  ]}
  faqs={[
    {
      q: 'Does PNG to WebP keep transparency?',
      a: 'Yes. The converter preserves the alpha channel, so transparent PNGs stay transparent in WebP.',
    },
    {
      q: 'Is WebP smaller than PNG?',
      a: 'Usually yes — WebP typically produces much smaller files than PNG for photos, while keeping transparency for graphics.',
    },
    {
      q: 'Can I convert multiple PNGs at once?',
      a: 'Yes. Drag in as many PNGs as you like, convert them all, and download them together as a ZIP.',
    },
    {
      q: 'What quality should I use?',
      a: 'For most images, quality 75-80 provides an excellent balance of file size and visual quality. For screenshots with text, use 85+.',
    },
  ]}
/>
