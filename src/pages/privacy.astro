---
import Layout from '../layouts/Layout.astro';

const faqLd = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: [
    {
      '@type': 'Question',
      name: 'Are my images uploaded to a server?',
      acceptedAnswer: {
        '@type': 'Answer',
        text: 'No. All processing happens locally in your browser using WebAssembly. Your files never leave your device, and there are no server-side logs of your images.',
      },
    },
    {
      '@type': 'Question',
      name: 'Does compression damage image quality?',
      acceptedAnswer: {
        '@type': 'Answer',
        text: 'Lossy formats (JPEG, WebP, AVIF) trade some quality for smaller size. You control the quality slider, or use target-size mode. PNG output is lossless.',
      },
    },
    {
      '@type': 'Question',
      name: 'Is there a limit on the number of images?',
      acceptedAnswer: {
        '@type': 'Answer',
        text: 'No hard limit. You can batch-process hundreds of images, though very large batches may use more memory.',
      },
    },
    {
      '@type': 'Question',
      name: 'Do you use cookies or trackers?',
      acceptedAnswer: {
        '@type': 'Answer',
        text: 'No third-party tracking. We use a self-hosted, cookie-free analytics tool (umami) for aggregate page-view counts only.',
      },
    },
  ],
};
---

<Layout
  title="Privacy — picture-zip"
  description="picture-zip processes all images locally in your browser. Your files are never uploaded, and we use no third-party tracking."
  jsonLd={[faqLd]}
>
  <section class="container page">
    <h1>Privacy</h1>
    <p class="lead">
      Your images never leave your device. Here's exactly what happens.
    </p>

    <div class="card">
      <h2>All processing is local</h2>
      <p>
        Every image you add is decoded, compressed and converted entirely inside your browser
        using WebAssembly. There is no upload step, no server-side storage, and no log of your
        image contents. The only network requests are for the static page assets themselves.
      </p>
    </div>

    <div class="card">
      <h2>No accounts, no cookies</h2>
      <p>
        picture-zip has no login, no accounts and no payment. We do not set cookies. A
        self-hosted, cookie-free analytics tool (umami) records aggregate page-view counts so we
        can understand which pages are useful — it never sees your images.
      </p>
    </div>

    <div class="card">
      <h2>Frequently asked questions</h2>
      <div class="faq__item">
        <h3>Does compression damage image quality?</h3>
        <p>Lossy formats (JPEG, WebP, AVIF) trade some quality for smaller size. You control the quality slider, or use target-size mode. PNG output is lossless.</p>
      </div>
      <div class="faq__item">
        <h3>Is there a limit on the number of images?</h3>
        <p>No hard limit. You can batch-process hundreds of images, though very large batches may use more memory.</p>
      </div>
      <div class="faq__item">
        <h3>Is my data safe?</h3>
        <p>Yes — because it never leaves your device. Closing the tab clears everything.</p>
      </div>
    </div>
  </section>
</Layout>

<style>
  .page {
    max-width: 760px;
    margin-top: 48px;
  }
  .page h1 {
    font-size: 34px;
    margin-bottom: 12px;
  }
  .lead {
    color: var(--muted);
    font-size: 17px;
    margin-bottom: 24px;
  }
  .card {
    margin-bottom: 18px;
  }
  .card h2 {
    font-size: 20px;
    margin-bottom: 10px;
  }
  .card p {
    color: var(--muted);
  }
  .faq__item {
    margin-bottom: 16px;
  }
  .faq__item h3 {
    font-size: 15px;
    margin-bottom: 4px;
  }
  .faq__item p {
    font-size: 14px;
  }
</style>