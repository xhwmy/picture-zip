---
import Layout from '../../layouts/Layout.astro';

const appLd = {
  '@context': 'https://schema.org',
  '@type': 'SoftwareApplication',
  name: 'picture-zip 图片压缩 API',
  url: 'https://picture-zip.com/zh/api/',
  applicationCategory: 'DeveloperApplication',
  operatingSystem: 'Web',
  description: '用于程序化图片压缩与转换的 REST API，即将推出。',
};
---

<Layout
  title="图片压缩 API — 即将推出 | picture-zip"
  description="程序化图片压缩与转换 API，通过 HTTP 压缩、调整尺寸并转换图片——即将推出。"
  lang="zh"
  jsonLd={[appLd]}
>
  <section class="container page">
    <h1>图片压缩 API</h1>
    <p class="lead">在自己的脚本和应用中自动化图片压缩与转换。</p>
    <div class="card coming-soon">
      <h2>HTTP API — 即将推出</h2>
      <p>我们正在构建一个简洁的 REST API，用于批量图片压缩、调整尺寸与格式转换（JPEG、WebP、AVIF、PNG）。</p>
      <ul class="list">
        <li>压缩图片到目标体积</li>
        <li>格式之间转换</li>
        <li>批量处理，简洁的 JSON 响应</li>
      </ul>
    </div>

    <div class="card contact">
      <h2>联系方式与反馈</h2>
      <p>有建议或功能需求？欢迎联系，期待你的反馈。</p>
      <ul class="list">
        <li>
          邮箱：<a href="mailto:18710189020@163.com">18710189020@163.com</a>
        </li>
        <li>
          GitHub：<a href="https://github.com/xhwmy/picture-zip" target="_blank" rel="noopener">github.com/xhwmy/picture-zip</a>
        </li>
      </ul>
      <p>欢迎直接在开源仓库提 issue 或 pull request。</p>
    </div>
  </section>
</Layout>

<style>
  .page { max-width: 760px; margin-top: 48px; }
  .page h1 { font-size: 34px; margin-bottom: 12px; }
  .lead { color: var(--muted); font-size: 17px; margin-bottom: 24px; }
  .coming-soon h2, .contact h2 { font-size: 20px; margin-bottom: 10px; }
  .coming-soon p, .contact p { color: var(--muted); margin-bottom: 14px; }
  .list { margin: 0 0 14px 20px; }
  .list li { margin: 4px 0; }
  .contact { margin-top: 20px; }
  .contact a { color: var(--link, #1f6feb); }
</style>