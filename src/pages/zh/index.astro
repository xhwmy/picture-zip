---
import Layout from '../../layouts/Layout.astro';
import { ImageTool } from '../../components/ImageTool';

const webAppLd = {
  '@context': 'https://schema.org',
  '@type': 'WebApplication',
  name: 'picture-zip — 图片压缩与格式转换',
  url: 'https://picture-zip.com/zh/',
  applicationCategory: 'MultimediaApplication',
  operatingSystem: 'Web',
  description: '纯浏览器本地处理的批量图片压缩与格式转换工具，支持 JPEG、WebP、AVIF、PNG，文件不上传。',
  offers: { '@type': 'Offer', price: '0', priceCurrency: 'USD' },
};

const faqLd = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: [
    {
      '@type': 'Question',
      name: '我的图片会被上传到服务器吗？',
      acceptedAnswer: {
        '@type': 'Answer',
        text: '不会。所有处理都在你的浏览器本地通过 WebAssembly 完成，文件绝不离开你的设备。',
      },
    },
    {
      '@type': 'Question',
      name: '有图片数量限制吗？',
      acceptedAnswer: {
        '@type': 'Answer',
        text: '没有硬性限制，可以批量处理数百张图片，但超大批量可能占用更多内存。',
      },
    },
  ],
};
---

<Layout
  title="免费图片压缩与格式转换 — picture-zip"
  description="批量压缩、调整尺寸并将图片转换为 JPEG、WebP、AVIF 或 PNG，全程在浏览器本地完成，文件不上传。"
  lang="zh"
  jsonLd={[webAppLd, faqLd]}
>
  <section class="hero">
    <div class="container">
      <h1 class="hero__title">无需上传即可<br /><span>压缩与转换图片</span></h1>
      <p class="hero__subtitle">
        批量压缩、调整尺寸并将图片转换为 JPEG、WebP、AVIF 或 PNG——全程在你的浏览器本地完成。
      </p>
      <div class="hero__badges">
        <span class="badge badge--accent">100% 本地处理</span>
        <span class="badge badge--green">文件不离开你的设备</span>
        <span class="badge badge--amber">无数量限制</span>
      </div>
    </div>
  </section>

  <section class="container tool-section">
    <ImageTool client:only="preact" />
  </section>

  <section class="container faq">
    <h2>常见问题</h2>
    <div class="faq__item">
      <h3>我的图片会被上传到服务器吗？</h3>
      <p>不会。所有处理都在你的浏览器本地通过 WebAssembly 完成，文件绝不离开你的设备。</p>
    </div>
    <div class="faq__item">
      <h3>压缩会损坏画质吗？</h3>
      <p>有损格式（JPEG、WebP、AVIF）以少量画质换取更小体积，你可以通过质量滑杆控制，或使用目标大小模式。PNG 输出为无损。</p>
    </div>
    <div class="faq__item">
      <h3>支持哪些格式？</h3>
      <p>输入：JPEG、PNG、WebP、GIF、AVIF。输出：JPEG、PNG、WebP、AVIF。</p>
    </div>
  </section>
</Layout>

<style>
  .hero {
    background: linear-gradient(135deg, #0f172a 0%, #1e3a8a 55%, #2563eb 100%);
    color: #fff;
    padding: 56px 0 64px;
    text-align: center;
  }
  .hero__title {
    font-size: 40px;
    line-height: 1.2;
    font-weight: 800;
  }
  .hero__title span {
    color: #bfdbfe;
  }
  .hero__subtitle {
    margin: 16px auto 0;
    max-width: 560px;
    color: #cbd5e1;
    font-size: 17px;
  }
  .hero__badges {
    margin-top: 22px;
    display: flex;
    justify-content: center;
    flex-wrap: wrap;
    gap: 10px;
  }
  .tool-section {
    margin-top: -28px;
    position: relative;
  }
  .faq {
    margin-top: 48px;
    max-width: 720px;
  }
  .faq h2 {
    font-size: 24px;
    margin-bottom: 16px;
  }
  .faq__item {
    margin-bottom: 20px;
  }
  .faq__item h3 {
    font-size: 16px;
    margin-bottom: 6px;
  }
  .faq__item p {
    color: var(--muted);
    font-size: 14px;
  }
  @media (max-width: 640px) {
    .hero__title {
      font-size: 28px;
    }
    .hero {
      padding: 40px 0 52px;
    }
  }
</style>