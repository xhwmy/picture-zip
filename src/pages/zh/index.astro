---
import Layout from '../../layouts/Layout.astro';
import { ImageTool } from '../../components/ImageTool';

const webAppLd = {
  '@context': 'https://schema.org',
  '@type': 'WebApplication',
  name: 'picture-zip — 图片压缩与格式转换',
  url: 'https://picture-zip.com/zh/',
  applicationCategory: 'MultimediaApplication',
  operatingSystem: 'Web',
  description: '纯浏览器本地处理的批量图片压缩与格式转换工具，支持 JPEG、WebP、AVIF、PNG，文件不上传。',
  offers: { '@type': 'Offer', price: '0', priceCurrency: 'USD' },
};

const faqLd = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: [
    {
      '@type': 'Question',
      name: '我的图片会被上传到服务器吗？',
      acceptedAnswer: {
        '@type': 'Answer',
        text: '不会。所有处理都在你的浏览器本地通过 WebAssembly 完成，文件绝不离开你的设备。',
      },
    },
    {
      '@type': 'Question',
      name: '有图片数量限制吗？',
      acceptedAnswer: {
        '@type': 'Answer',
        text: '没有硬性限制，可以批量处理数百张图片，但超大批量可能占用更多内存。',
      },
    },
  ],
};
---

<Layout
  title="免费图片压缩与格式转换 — picture-zip"
  description="批量压缩、调整尺寸并将图片转换为 JPEG、WebP、AVIF 或 PNG，全程在浏览器本地完成，文件不上传。"
  lang="zh"
  jsonLd={[webAppLd, faqLd]}
>
  <section class="hero">
    <div class="container hero__inner">
      <div class="hero__text">
        <h1 class="hero__title">无需上传即可<br /><span>压缩与转换图片</span></h1>
        <p class="hero__subtitle">
          批量压缩、调整尺寸并将图片转换为 JPEG、WebP、AVIF 或 PNG——全程在你的浏览器本地完成。
        </p>
        <div class="hero__badges">
          <span class="badge badge--accent">100% 本地</span>
          <span class="badge badge--green">不上传</span>
          <span class="badge badge--amber">无限制</span>
        </div>
      </div>
      <div class="hero__demo">
        <div class="hero__demo-item">
          <img src="/demo-before.jpg" alt="压缩前" loading="eager" width="200" height="150" />
          <span class="hero__demo-label">141 KB</span>
        </div>
        <div class="hero__demo-arrow" aria-hidden="true">→</div>
        <div class="hero__demo-item">
          <img src="/demo-after.jpg" alt="压缩后" loading="eager" width="200" height="150" />
          <span class="hero__demo-label hero__demo-label--accent">13 KB</span>
        </div>
        <div class="hero__demo-badge">缩小 91%</div>
      </div>
    </div>
  </section>

  <section class="container tool-section">
    <ImageTool client:only="preact" />
  </section>

  <section class="container faq">
    <h2>常见问题</h2>
    <div class="faq__item">
      <h3>我的图片会被上传到服务器吗？</h3>
      <p>不会。所有处理都在你的浏览器本地通过 WebAssembly 完成，文件绝不离开你的设备。</p>
    </div>
    <div class="faq__item">
      <h3>压缩会损坏画质吗？</h3>
      <p>有损格式（JPEG、WebP、AVIF）以少量画质换取更小体积，你可以通过质量滑杆控制，或使用目标大小模式。PNG 输出为无损。</p>
    </div>
    <div class="faq__item">
      <h3>支持哪些格式？</h3>
      <p>输入：JPEG、PNG、WebP、GIF、AVIF。输出：JPEG、PNG、WebP、AVIF。</p>
    </div>
  </section>

  <section class="container app-download">
    <h2>下载 Android 应用</h2>
    <p>手机上直接压缩图片——从相册选择、压缩、一键替换原图。</p>
    <a href="/picture-app-v3.01.apk" class="download-btn" download>下载 APK · v3.01 · 6.1 MB</a>
    <p class="app-download__note">仅限安卓设备 · 需 Android 7.0+</p>
  </section>
</Layout>

<style>
  .hero {
    background: var(--bg);
    padding: 48px 0 56px;
    border-bottom: 1px solid var(--line);
  }
  .hero__inner {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 40px;
  }
  .hero__text {
    flex: 1;
  }
  .hero__title {
    font-size: 40px;
    line-height: 1.2;
    font-weight: 800;
    color: var(--ink);
  }
  .hero__title span {
    color: var(--accent);
  }
  .hero__subtitle {
    margin: 16px 0 0;
    max-width: 560px;
    color: var(--muted);
    font-size: 17px;
  }
  .hero__badges {
    margin-top: 22px;
    display: flex;
    flex-wrap: wrap;
    gap: 10px;
  }
  .hero__demo {
    position: relative;
    display: flex;
    align-items: center;
    gap: 16px;
    padding: 20px;
    background: #f8fafc;
    border-radius: 12px;
    border: 1px solid var(--line);
  }
  .hero__demo-item {
    text-align: center;
  }
  .hero__demo-item img {
    border-radius: 8px;
    border: 1px solid var(--line);
  }
  .hero__demo-label {
    display: block;
    margin-top: 8px;
    font-size: 13px;
    color: var(--muted);
  }
  .hero__demo-label--accent {
    color: var(--accent);
    font-weight: 600;
  }
  .hero__demo-arrow {
    font-size: 24px;
    color: var(--muted);
  }
  .hero__demo-badge {
    position: absolute;
    top: -10px;
    right: -10px;
    background: var(--accent);
    color: #fff;
    font-size: 12px;
    font-weight: 600;
    padding: 4px 10px;
    border-radius: 999px;
  }
  .tool-section {
    margin-top: -28px;
    position: relative;
  }
  .faq {
    margin-top: 48px;
    max-width: 720px;
  }
  .faq h2 {
    font-size: 24px;
    margin-bottom: 16px;
  }
  .faq__item {
    margin-bottom: 20px;
  }
  .faq__item h3 {
    font-size: 16px;
    margin-bottom: 6px;
  }
  .faq__item p {
    color: var(--muted);
    font-size: 14px;
  }
  .app-download {
    margin-top: 48px;
    max-width: 720px;
    padding: 28px 32px;
    background: var(--card);
    border: 1px solid var(--line);
    border-radius: var(--radius-lg);
    text-align: center;
  }
  .app-download h2 {
    font-size: 22px;
    margin-bottom: 8px;
  }
  .app-download p {
    color: var(--muted);
    font-size: 15px;
    margin-bottom: 20px;
  }
  .download-btn {
    display: inline-block;
    padding: 12px 32px;
    background: var(--accent);
    color: #fff;
    font-size: 16px;
    font-weight: 600;
    border-radius: 10px;
    text-decoration: none;
    transition: opacity 0.15s ease;
  }
  .download-btn:hover {
    opacity: 0.88;
  }
  .app-download__note {
    margin-top: 12px;
    font-size: 13px;
    color: var(--muted);
  }
  @media (max-width: 768px) {
    .hero__inner {
      flex-direction: column;
    }
    .hero__demo {
      width: 100%;
      justify-content: center;
    }
    .hero__demo-item img {
      width: auto;
      max-width: min(42vw, 160px);
      height: auto;
    }
    .hero__title {
      font-size: 28px;
    }
    .hero {
      padding: 32px 0 40px;
    }
  }
  @media (max-width: 640px) {
    .hero__demo {
      flex-wrap: wrap;
      justify-content: center;
      gap: 12px;
      padding: 16px;
      overflow: hidden;
    }
    .hero__demo-item img {
      width: min(40vw, 140px);
      max-width: min(40vw, 140px);
      height: auto;
    }
    .hero__demo-arrow {
      width: 100%;
      text-align: center;
      font-size: 20px;
    }
    .hero__demo-badge {
      top: 4px;
      right: 4px;
      font-size: 11px;
      padding: 3px 8px;
    }
  }
</style>