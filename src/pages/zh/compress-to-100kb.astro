---
import ToolScene from '../../components/ToolScene.astro';
const targetKB = 100;
---

<ToolScene
  lang="zh"
  title={`图片压缩到 ${targetKB}KB — 免费本地处理`}
  description={`免费将任意图片压缩到 ${targetKB}KB 以内，全程本地处理，文件不上传。`}
  heading="图片压缩到"
  highlight={`${targetKB}KB`}
  subtitle={`精确压到 ≤ ${targetKB}KB，适合考试报名、签证等照片要求——全程本地，不上传。`}
  initialSettings={{ targetSizeKB: targetKB }}
  webAppName={`图片压缩 — 压到 ${targetKB}KB`}
  webAppUrl={`https://picture-zip.com/zh/compress-to-${targetKB}kb/`}
  faqs={[
    {
      q: `如何把图片压到 ${targetKB}KB？`,
      a: `拖入图片，目标大小模式会自动调节质量（必要时降低分辨率），直到文件 ≤ ${targetKB}KB。`,
    },
    {
      q: '压完还清晰吗？',
      a: '会。工具会找到能压到目标体积的最高质量，仅在最后才降低分辨率。',
    },
    {
      q: '图片会被上传吗？',
      a: '不会。所有处理都在浏览器本地通过 WebAssembly 完成，文件绝不离开你的设备。',
    },
  ]}
/>